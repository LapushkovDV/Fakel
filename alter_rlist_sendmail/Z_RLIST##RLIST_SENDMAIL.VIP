#component "Z_RLIST"
#include PsnFuncs.vih // Функции работы с таблицей Persons
Alter Interface vRList_SendMail;
OverLoad
//  function RenameRL(oldName: string): string;
  function PasswordProtection(_protect: boolean; resfile: string; seMail: s100): string;
end;//OverLoad

var _log : string;
procedure mylog(_str : string); {
  if _log = '' {
    _log := GetStringParameter('Files','OutputFilesDirectory',0)+ '\send_email_'+DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS-SSS') +'.log';
  }
  LogStrToFile(_log, DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS') + ': ' + _str);
}
